{
  "name": "phreaknic-online-01",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{"pattern":"online-01.phreaknic-ccg.net","custom_domain":true}],
  "observability": {"enabled":true},
  "exports": {
    "Room":{"type":"durable-object","storage":"sqlite","container":"phreaknic-rooms"},
    "Lobby":{"type":"durable-object","storage":"sqlite"}
  },
  "durable_objects":{"bindings":[{"name":"ROOMS","class_name":"Room"},{"name":"LOBBY","class_name":"Lobby"}]},
  "containers":[{"name":"phreaknic-rooms","class_name":"Room","scheduling_policy":"durable_object","images":{"base":{"dockerfile":"./container/Dockerfile","build_context":"./container"}}}],
  "env":{"dev":{
    "workers_dev":true,"routes":[],
    "exports":{"Room":{"type":"durable-object","storage":"sqlite","container":"phreaknic-rooms-dev"},"Lobby":{"type":"durable-object","storage":"sqlite"}},
    "durable_objects":{"bindings":[{"name":"ROOMS","class_name":"Room"},{"name":"LOBBY","class_name":"Lobby"}]},
    "containers":[{"name":"phreaknic-rooms-dev","class_name":"Room","scheduling_policy":"durable_object","images":{"base":{"dockerfile":"./container/Dockerfile","build_context":"./container"}}}]
  }}
}
