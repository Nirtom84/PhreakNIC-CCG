; Engine configuration file.
config_version=5

[application]
config/version="0.21"
config/quit_on_go_back=false
config/name="PhreakNIC CCG"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon/icon.png"
config/windows_native_icon="res://assets/icon/icon.ico"
boot_splash/bg_color=Color(0.0196, 0.0353, 0.051, 1)
boot_splash/image="res://assets/icon/splash.png"
boot_splash/fullsize=false
boot_splash/stretch_mode=0

[autoload]
TouchInput="*res://scripts/ui/touch.gd"
Sfx="*res://scripts/ui/sfx.gd"
CardDB="*res://scripts/core/card_db.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

